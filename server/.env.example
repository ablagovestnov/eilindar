# Скопируйте в .env на сервере и заполните.
PORT=8787
DB_PATH=/opt/eilindar-server/data/eilindar.db
# Задайте длинный случайный токен, чтобы закрыть запись/чтение:
# API_TOKEN=замените-на-длинную-случайную-строку
# Если фронт на другом домене (не same-origin через Caddy) — укажите его:
# CORS_ORIGIN=https://eilindar.example.com
